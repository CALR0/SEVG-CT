# Required: cualquier cadena ≥16 caracteres, aleatoria. Rota la cuenta de cualquier
# cookie firmada al cambiar este valor.
SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# Opcional (defaults ya correctos):
# CONTROLT_AUTH_BASE=https://app.controlt.com.co
# CONTROLT_REPORTS_BASE=https://reports-api.controlt.io
# CONTROLT_TZ=America/Bogota

# Persistencia (Neon). Si no está definida, el histórico queda deshabilitado y
# la app funciona en modo sólo-memoria (sesión actual). Vercel inyecta esta
# variable sola cuando conectas la BD desde Storage → Neon.
# DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
